# Dependencies (there are none, but never commit them if that changes)
node_modules/

# Logs
*.log
npm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Build and scratch output
dist/
build/
tmp/
*.tmp

# Server-side player data - never commit accounts or saves.
# The leading slash matters: without it this also matches js/data/, and a new
# file in there would be silently left out of every commit and every image.
/data/

# Content pipeline scratch. The daily workflow writes the brief into the
# working tree and then checks that nothing outside content/packs changed, so
# these have to be invisible to git or the run fails on its own leftovers.
/brief.json
/.smoke-data/
